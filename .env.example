# Optional. The application runs without an API key using deterministic, grounded analysis.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
# Only enable for trusted local tests, NEVER for a publicly accessible deployment.
ALLOW_PRIVATE_NETWORK=false
# Number of concurrent background crawl jobs.
MAX_CONCURRENT_JOBS=2
